@model Student

<div class="container">
    <h2>Thêm sinh viên</h2>

    <form asp-controller="Student" asp-action="Create" method="post">

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="form-group mt-3">
            <label asp-for="Name">Họ tên</label>
            <input asp-for="Name" class="form-control" placeholder="Nhập họ tên" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group mt-3">
            <label asp-for="Email">Email</label>
            <input asp-for="Email" class="form-control" placeholder="Nhập email Gmail" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group mt-3">
            <label asp-for="Password">Mật khẩu</label>
            <input asp-for="Password" type="password" class="form-control"
                   placeholder="Nhập mật khẩu" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group mt-3">
            <label asp-for="Branch">Ngành học</label>
            <select asp-for="Branch" class="form-control"
                    asp-items="Html.GetEnumSelectList<Branch>()">
                <option value="">-- Chọn ngành học --</option>
            </select>
            <span asp-validation-for="Branch" class="text-danger"></span>
        </div>

        <div class="form-group mt-3">
            <label asp-for="Gender">Giới tính</label><br />

            @foreach (var gender in ViewBag.AllGenders)
            {
                <label class="me-3">
                    <input type="radio" asp-for="Gender" value="@gender" />
                    @gender
                </label>
            }

            <br />
            <span asp-validation-for="Gender" class="text-danger"></span>
        </div>

        <div class="form-check mt-3">
            <input asp-for="IsRegular" class="form-check-input" />
            <label asp-for="IsRegular" class="form-check-label">
                Hệ chính quy
            </label>
        </div>

        <div class="form-group mt-3">
            <label asp-for="DateOfBorth">Ngày sinh</label>
            <input asp-for="DateOfBorth" type="date" class="form-control" />
            <span asp-validation-for="DateOfBorth" class="text-danger"></span>
        </div>

        <div class="form-group mt-3">
            <label asp-for="Address">Địa chỉ</label>
            <textarea asp-for="Address" class="form-control"
                      placeholder="Nhập địa chỉ"></textarea>
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>

        <div class="form-group mt-3">
            <label asp-for="GPA">Điểm trung bình</label>
            <input asp-for="GPA" type="number" min="0" max="10"
                   step="0.1" class="form-control"
                   placeholder="Nhập điểm từ 0.0 đến 10.0" />
            <span asp-validation-for="GPA" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary mt-3">
            Thêm sinh viên
        </button>

        <a asp-controller="Student" asp-action="Index"
           class="btn btn-secondary mt-3">Quay lại</a>

    </form>
</div>
